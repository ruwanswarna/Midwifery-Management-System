--
-- Table structure for table `pregnancy`
--

DROP TABLE IF EXISTS `pregnancy`;
/*!40101 SET @saved_cs_client     = @@character_set_client */;
/*!50503 SET character_set_client = utf8mb4 */;
CREATE TABLE `pregnancy` (
  `pregnancy_id` int NOT NULL AUTO_INCREMENT,
  `mother_id` int NOT NULL,
  `registered_date` date NOT NULL,
  `booking_date` date DEFAULT NULL,
  `last_menstrual_period` date NOT NULL,
  `expected_delivery_date` date NOT NULL,
  `pregnancy_age_at_registration` int DEFAULT NULL,
  `gravida` int DEFAULT NULL,
  `para` int DEFAULT NULL,
  `abortions` int DEFAULT '0',
  `living_children` int DEFAULT '0',
  `bmi_at_booking` decimal(4,1) DEFAULT NULL,
  `hemoglobin_level` decimal(4,1) DEFAULT NULL,
  `blood_pressure` varchar(10) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci DEFAULT NULL,
  `pregnancy_type` enum('Singleton','Twins','Triplets','Other') CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci DEFAULT 'Singleton',
  `risk_status` enum('Low','Moderate','High') CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci DEFAULT 'Low',
  `current_status` enum('Ongoing','Delivered','Transferred','Terminated') CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci DEFAULT 'Ongoing',
  `remarks` text CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci,
  `created_at` timestamp NULL DEFAULT CURRENT_TIMESTAMP,
  `updated_at` timestamp NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
  PRIMARY KEY (`pregnancy_id`),
  KEY `idx_pregnancy_mother` (`mother_id`),
  KEY `idx_pregnancy_edd` (`expected_delivery_date`),
  KEY `idx_pregnancy_status` (`current_status`,`expected_delivery_date`),
  CONSTRAINT `fk_pregnancy_mother` FOREIGN KEY (`mother_id`) REFERENCES `person` (`person_id`) ON DELETE RESTRICT ON UPDATE CASCADE,
  CONSTRAINT `chk_abortions` CHECK ((`abortions` >= 0)),
  CONSTRAINT `chk_bmi` CHECK ((`bmi_at_booking` between 10 and 60)),
  CONSTRAINT `chk_gravida` CHECK ((`gravida` >= 0)),
  CONSTRAINT `chk_gravida_compare` CHECK ((`gravida` >= `para`)),
  CONSTRAINT `chk_hemoglobin` CHECK ((`hemoglobin_level` between 1 and 25)),
  CONSTRAINT `chk_living_children` CHECK ((`living_children` >= 0)),
  CONSTRAINT `chk_para` CHECK ((`para` >= 0))
) ENGINE=InnoDB AUTO_INCREMENT=72 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;
/*!40101 SET character_set_client = @saved_cs_client */;

--
-- Dumping data for table `pregnancy`
--

LOCK TABLES `pregnancy` WRITE;
/*!40000 ALTER TABLE `pregnancy` DISABLE KEYS */;
