  CONSTRAINT `fk_appointment_pregnancy` FOREIGN KEY (`pregnancy_id`) REFERENCES `pregnancy` (`pregnancy_id`) ON DELETE SET NULL ON UPDATE CASCADE,
  CONSTRAINT `fk_appointment_session` FOREIGN KEY (`clinic_session_id`) REFERENCES `clinic_session` (`clinic_session_id`) ON DELETE CASCADE ON UPDATE CASCADE
