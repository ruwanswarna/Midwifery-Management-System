--
-- Table structure for table `field_visit`
--

DROP TABLE IF EXISTS `field_visit`;
/*!40101 SET @saved_cs_client     = @@character_set_client */;
/*!50503 SET character_set_client = utf8mb4 */;
CREATE TABLE `field_visit` (
  `visit_id` int NOT NULL AUTO_INCREMENT,
  `family_id` int NOT NULL,
  `staff_id` int NOT NULL,
  `person_id` int DEFAULT NULL,
  `pregnancy_id` int DEFAULT NULL,
  `visit_date` date NOT NULL,
  `visit_type` enum('Routine','Follow-up','Emergency','Postnatal','Child Welfare') CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci NOT NULL,
  `visit_status` enum('Completed','Cancelled','Rescheduled') CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci DEFAULT 'Completed',
  `follow_up_required` tinyint(1) DEFAULT '0',
  `follow_up_date` date DEFAULT NULL,
  `observations` text CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci,
  `risk_identified` tinyint(1) DEFAULT '0',
  `created_at` timestamp NULL DEFAULT CURRENT_TIMESTAMP,
  `updated_at` timestamp NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
  PRIMARY KEY (`visit_id`),
  KEY `fk_visit_pregnancy` (`pregnancy_id`),
  KEY `idx_visit_family` (`family_id`),
  KEY `idx_visit_person` (`person_id`),
  KEY `idx_visit_staff` (`staff_id`),
  KEY `idx_visit_date` (`visit_date`),
  KEY `idx_visit_family_date` (`family_id`,`visit_date`),
  CONSTRAINT `fk_visit_family` FOREIGN KEY (`family_id`) REFERENCES `family` (`family_id`) ON DELETE RESTRICT ON UPDATE CASCADE,
  CONSTRAINT `fk_visit_person` FOREIGN KEY (`person_id`) REFERENCES `person` (`person_id`) ON DELETE SET NULL ON UPDATE CASCADE,
  CONSTRAINT `fk_visit_pregnancy` FOREIGN KEY (`pregnancy_id`) REFERENCES `pregnancy` (`pregnancy_id`) ON DELETE SET NULL ON UPDATE CASCADE,
  CONSTRAINT `fk_visit_staff` FOREIGN KEY (`staff_id`) REFERENCES `staff` (`staff_id`) ON DELETE RESTRICT ON UPDATE CASCADE
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;
/*!40101 SET character_set_client = @saved_cs_client */;

--
-- Dumping data for table `field_visit`
--

LOCK TABLES `field_visit` WRITE;
/*!40000 ALTER TABLE `field_visit` DISABLE KEYS */;
/*!40000 ALTER TABLE `field_visit` ENABLE KEYS */;
UNLOCK TABLES;

--
-- Table structure for table `growth_measurement`
--

DROP TABLE IF EXISTS `growth_measurement`;
/*!40101 SET @saved_cs_client     = @@character_set_client */;
/*!50503 SET character_set_client = utf8mb4 */;
CREATE TABLE `growth_measurement` (
  `measurement_id` int NOT NULL AUTO_INCREMENT,
  `child_id` int NOT NULL,
  `measured_by` int NOT NULL,
  `measurement_date` date NOT NULL,
  `age_in_days` int NOT NULL,
  `age_in_months` int NOT NULL,
  `weight_kg` decimal(5,2) DEFAULT NULL,
  `height_cm` decimal(5,2) DEFAULT NULL,
  `head_circumference_cm` decimal(5,2) DEFAULT NULL,
  `muac_cm` decimal(5,2) DEFAULT NULL,
  `bmi` decimal(5,2) DEFAULT NULL,
  `weight_for_age_z_score` decimal(4,2) DEFAULT NULL,
  `height_for_age_z_score` decimal(4,2) DEFAULT NULL,
  `weight_for_height_z_score` decimal(4,2) DEFAULT NULL,
  `growth_status` enum('Normal','Underweight','Severely Underweight','Stunted','Severely Stunted','Wasted','Severely Wasted','Overweight') CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci DEFAULT NULL,
  `remarks` text CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci,
  `created_at` timestamp NULL DEFAULT CURRENT_TIMESTAMP,
  `updated_at` timestamp NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
  PRIMARY KEY (`measurement_id`),
  KEY `idx_growth_child` (`child_id`),
  KEY `idx_growth_staff` (`measured_by`),
  KEY `idx_growth_date` (`measurement_date`),
  KEY `idx_growth_age` (`age_in_days`),
  KEY `idx_growth_status` (`growth_status`),
  KEY `idx_growth_zscores` (`weight_for_age_z_score`,`height_for_age_z_score`,`weight_for_height_z_score`),
  KEY `idx_growth_child_date` (`child_id`,`measurement_date`),
  CONSTRAINT `fk_growth_child` FOREIGN KEY (`child_id`) REFERENCES `child` (`person_id`) ON DELETE CASCADE ON UPDATE CASCADE,
  CONSTRAINT `fk_growth_staff` FOREIGN KEY (`measured_by`) REFERENCES `staff` (`staff_id`) ON DELETE RESTRICT ON UPDATE CASCADE,
  CONSTRAINT `chk_age_days` CHECK ((`age_in_days` >= 0)),
  CONSTRAINT `chk_age_months` CHECK ((`age_in_months` >= 0)),
  CONSTRAINT `chk_growth_values` CHECK (((`weight_kg` >= 0) and (`height_cm` >= 0) and (`head_circumference_cm` >= 0) and (`muac_cm` >= 0)))
) ENGINE=InnoDB AUTO_INCREMENT=514 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;
/*!40101 SET character_set_client = @saved_cs_client */;

