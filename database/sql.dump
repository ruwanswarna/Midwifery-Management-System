CREATE TABLE `vaccine_schedule` (
  `schedule_id` int NOT NULL AUTO_INCREMENT,
  `vaccine_id` int NOT NULL,
  `dose_number` int NOT NULL,
  `recommended_age_months` int NOT NULL,
  `description` varchar(255) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci DEFAULT NULL,
  `created_at` timestamp NULL DEFAULT CURRENT_TIMESTAMP,
  `updated_at` timestamp NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
  PRIMARY KEY (`schedule_id`),
  UNIQUE KEY `uq_vaccine_dose` (`vaccine_id`,`dose_number`),
  KEY `idx_schedule_vaccine` (`vaccine_id`),
  CONSTRAINT `fk_schedule_vaccine` FOREIGN KEY (`vaccine_id`) REFERENCES `vaccine_master` (`vaccine_id`) ON DELETE RESTRICT ON UPDATE CASCADE,
  CONSTRAINT `chk_dose_number` CHECK ((`dose_number` > 0)),
  CONSTRAINT `chk_recommended_age` CHECK ((`recommended_age_months` >= 0))
) ENGINE=InnoDB AUTO_INCREMENT=15 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;
