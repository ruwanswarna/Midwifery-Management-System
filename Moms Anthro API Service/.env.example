# Copy these settings into Windows environment variables before starting run.R.
MOMS_ANTHRO_HOST=127.0.0.1
MOMS_ANTHRO_PORT=8000

# Use a strong, private random value in production. Leave unset only during local development.
MOMS_ANTHRO_API_KEY=replace-with-a-long-random-secret

# Set only if your PHP/API front end is served from another origin.
# MOMS_ANTHRO_ALLOWED_ORIGIN=https://moms.example.lk
